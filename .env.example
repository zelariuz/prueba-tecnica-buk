# Conexión a la base del docker-compose (el host publica Postgres en 5433).
DATABASE_URL=postgres://capa:capa@localhost:5433/capa_semantica

# Caché L2 compartida entre instancias (el host publica Redis en 6380). Es
# opcional: sin esta variable el servicio arranca igual y sirve sólo con la L1 en
# memoria de cada proceso. Los tests que la necesitan se saltan con aviso si falta.
REDIS_URL=redis://localhost:6380

# Tokens de demo del servicio HTTP: { token → { companyId, consumer } }.
# La autenticación real está fuera de alcance (el PRD la deja a la aplicación):
# esta tabla existe para poder ejercitar el contrato. Son valores falsos y
# públicos a propósito; nunca pongas aquí un secreto real.
DEMO_TOKENS={"demo-dashboard-empresa-a":{"companyId":1,"consumer":"dashboard"},"demo-api-empresa-a":{"companyId":1,"consumer":"api"},"demo-agente-empresa-a":{"companyId":1,"consumer":"agent"},"demo-dashboard-empresa-b":{"companyId":2,"consumer":"dashboard"}}

# Puerto del servicio HTTP dentro del contenedor (el host lo publica en 3000).
PORT=3000
