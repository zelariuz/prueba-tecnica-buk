# Copia este archivo a `.env` (ignorado por git) y ajusta lo que haga falta.

# Dónde escucha la capa semántica levantada con `docker compose up -d --build`
# en la raíz del repo.
CAPA_URL=http://localhost:3000

# Token de clase `agente`: el que usa la consulta real. Su clase exige acotar
# el tiempo, y eso es justo lo que la demo muestra.
#
# Un par por empresa —el de clase agente y el interno—, porque en la capa la
# empresa viaja en el TOKEN y no en la consulta (ADR 0002): el selector de la
# página es un selector de token. Sin estas variables la demo arranca igual,
# usando como valor el propio nombre del token, que es lo que dice el
# `docker-compose.yml` del repo.
TOKEN_AGENTE_A=demo-agente-empresa-a
TOKEN_AGENTE_C=demo-agente-empresa-c

# Token interno: el único que recibe el SQL en el dry-run. Nunca sale a la
# página; la página muestra el NOMBRE del token, jamás su valor.
TOKEN_INTERNO_A=demo-interno-empresa-a
TOKEN_INTERNO_C=demo-interno-empresa-c

# Compatibilidad: `TOKEN_AGENTE` y `TOKEN_INTERNO` sin sufijo siguen valiendo y
# son los de la empresa A.

# Puerto del mini back de la demo.
PUERTO=3100

# Nombre de la sesión de Claude Code con la que habla la demo. El uuid NO va
# acá: lo genera el arranque y queda anotado en `.sesion.json` junto a la
# versión y la huella del catálogo con el que se creó la sesión.
SESION_NOMBRE=agente-buk

# Modelo de la sesión del agente.
MODELO=claude-sonnet-5

# Tope de tiempo por llamada al agente: al vencer, el proceso se mata y el
# salto queda como fallo en vez de colgar la demo.
AGENTE_TIMEOUT_MS=60000
