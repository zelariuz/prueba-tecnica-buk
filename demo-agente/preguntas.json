[
  {
    "id": "evaluaciones-por-departamento",
    "titulo": "Evaluaciones por departamento y trimestre",
    "texto": "Score promedio y evaluaciones completadas por departamento y trimestre, entre :desde y :hasta, para :departamento.",
    "filtros": [
      "desde",
      "hasta",
      "departamento"
    ],
    "consulta": {
      "measures": [
        "reviews.avg_score",
        "reviews.completed_count"
      ],
      "dimensions": [
        "departments.name"
      ],
      "segments": [
        "reviews.completed"
      ],
      "timeDimensions": [
        {
          "dimension": "reviews.period",
          "granularity": "quarter",
          "dateRange": [
            ":desde",
            ":hasta"
          ]
        }
      ],
      "filters": [
        {
          "member": "departments.name",
          "operator": "equals",
          "values": [
            ":departamento"
          ]
        }
      ],
      "order": {
        "reviews.period": "asc"
      },
      "limit": 500
    }
  },
